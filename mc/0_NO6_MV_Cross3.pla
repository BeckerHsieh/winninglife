// ==============================
// 0_NO6_MV_Cross3  (2026/11/10)
// Based on 0_NO5_MV_Cross3 (entries/exits unchanged) + trailing stop per direction.
// With the 6 new inputs at 0 it behaves exactly like 0_NO5_MV_Cross3.
// Trailing stop (points): once the best price since entry has moved >= xTrailStart
// in favour of the position, exit next bar with a stop at best - xTrailPt (long) /
// best + xTrailPt (short). Optional fixed stop xStopPt points from entry (0 = off);
// when both apply the tighter stop is used. Active at all times (not limited by pSTime/pETime).
// ==============================

Inputs: tradeSignal(1),pSTime(0915),pETime(2400),pBEntryLen(2);
Inputs: Price(Close), FastAvg(10), SlowAvg(60), AvgFitr(120);
Inputs: LoseAvg(6),LoseScope(10),LostMulti(5);
Inputs: lTrailStart(0), lTrailPt(0), sTrailStart(0), sTrailPt(0);   // points, 0 = off
Inputs: lStopPt(0), sStopPt(0);                                     // points, 0 = off
Vars: FastMA(0), SlowMA(0), Filter(0), LoseMA(0), BestHi(0), BestLo(0), StopPx(0);

FastMA = Average (Price, FastAvg);
SlowMA = Average (Price, SlowAvg);
Filter = Average (Price, AvgFitr);
LoseMA = Average (Price, LoseAvg);

Condition1 = Close > Filter;
Condition2 = Close < Filter;

IF tradeSignal <> -1 and t>pSTime and t<pETime and (barssinceexit(1) > pBEntryLen or totaltrades = 0) 
	And marketposition <= 0
	And Close >= Highest(close, FastAvg)
	And FastMA > SlowMA 
	And Condition1
	Then
  buy("MVc") next bar at market;
IF t>pSTime and t<pETime 
	And marketposition > 0	
	And Close < entryprice(0) And LoseMA[1]-LoseMA > LoseScope Then
  Sell("MVc_s") next bar at market;

IF tradeSignal <> 1 and t>pSTime and t<pETime and (barssinceexit(1) > pBEntryLen or totaltrades = 0)
	And marketposition >= 0
	And FastMA crosses below SlowMA 
	And Condition2 Then
  sellshort("MVs") next bar at market;
IF t>pSTime and t<pETime 
	And marketposition < 0
	And Close > entryprice(0) 
	And Close-Close[1] > LoseScope And Close[1]-Close[2] > LoseScope And Close[2]-Close[3] > LoseScope Then
  buytocover("MVs_b") next bar at market;

// ---- trailing stop ----
If marketposition > 0 then Begin
	If barssinceentry = 0 then BestHi = High else if High > BestHi then BestHi = High;
	StopPx = 0;
	If lTrailPt > 0 and BestHi - entryprice(0) >= lTrailStart then StopPx = BestHi - lTrailPt;
	If lStopPt > 0 then StopPx = MaxList(StopPx, entryprice(0) - lStopPt);
	If StopPx > 0 then Sell("MVc_tr") next bar at StopPx stop;
End;
If marketposition < 0 then Begin
	If barssinceentry = 0 then BestLo = Low else if Low < BestLo then BestLo = Low;
	StopPx = 0;
	If sTrailPt > 0 and entryprice(0) - BestLo >= sTrailStart then StopPx = BestLo + sTrailPt;
	If sStopPt > 0 then Begin
		If StopPx = 0 then StopPx = entryprice(0) + sStopPt else StopPx = MinList(StopPx, entryprice(0) + sStopPt);
	End;
	If StopPx > 0 then buytocover("MVs_tr") next bar at StopPx stop;
End;
