// ==============================
// Strategy: 0_NO6_Fast6 = 0_NO6_Fast5 with two entry time windows in ONE signal.
// Replaces running two Fast5 signals (0915~2400 and 0000~0450) on the same chart:
// signals in one strategy share the position, so each Fast5 sent its own copy of
// every exit order (duplicate L-TP / SL orders at the broker).
// Time windows only gate entries; exits are always active (same as Fast5).
// Entry counts reset when a window starts (equivalent to Fast5's daily reset per signal).
// Set pSTime2 = pETime2 to disable the second window.
// pExitWin = 1 (2026-11-10): exits only for positions opened inside this signal's
// windows (fixes duplicate SF2SL fills when two Fast5 run on the MXF chart, 11/10 12:31).
// ==============================

Inputs:
    tradeSignal(0),      // 1=Long only, 0=Both, -1=Short only
    pSTime(0915),        // window 1 (entry allowed when pSTime < t < pETime)
    pETime(2400),
    pSTime2(0000),       // window 2
    pETime2(0450),
    // ---- Short (unchanged from 0_NO6_Fast4) ----
    pBEntryLen(3),
    FastAvg(90),
    SlowAvg(150),
    AvgFitr(90),
    HLScope(350),
    BasePoint(150),
    StopLossPt(300),     // points, 0 = off
    // ---- Long (MACD) ----
    lBEntryLen(1),
    lFastAvg(60),
    lSlowAvg(200),
    lAvgFitr(60),
    lHLScope(50),
    lMacdFast(25),
    lMacdSlow(80),
    lMacdSmooth(9),
    LEntry(-5),          // long entry: xmacd crosses over
    LExit(-60),          // long exit: xmacd crosses under
    LStopPt(0),          // points, 0 = off
    // ---- Exit ownership by time window (2026-11-10) ----
    pExitWin(0);         // 0 = exits always active (original behavior)
                         // 1 = exits only for a position whose entry order was sent inside
                         //     this signal's time windows. Use when several Fast5 signals with
                         //     NON-overlapping windows share one chart, so only the signal that
                         //     opened the position sends its exit / stop orders.


Vars:
    FastMA(0), SlowMA(0), Filter(0), HH(0), LL(0),
    HLRange(0), MaxEntries(0), EntryCount(0),
    lFastMA(0), lSlowMA(0), lHLRange(0), lMaxEntries(0), lEntryCount(0),
    dif(0), dem(0), xmacd(0),
    LongSignal(false), LongExitSig(false), LongOrder(false),
    ConditionTime(false),
    TimeWin(0),          // 0 = outside windows, 1 = window 1, 2 = window 2
    AllowLong(false),
    AllowShort(false),
    OwnPos(true),        // position was opened by an order sent inside this signal's windows
    ExitOK(true);

// ==============================
// Direction control
// ==============================
AllowLong  = (tradeSignal = 1) or (tradeSignal = 0);
AllowShort = (tradeSignal = -1) or (tradeSignal = 0);

// ==============================
// Indicator calculation
// ==============================
FastMA = Average(Close, FastAvg);
SlowMA = Average(Close, SlowAvg);
Filter = Average(Close, AvgFitr);
HH = Highest(High, AvgFitr)[1];
LL = Lowest(Low, AvgFitr)[1];
HLRange = Highest(High, AvgFitr) - Lowest(Low, AvgFitr);

lFastMA = Average(Close, lFastAvg);
lSlowMA = Average(Close, lSlowAvg);
lHLRange = Highest(High, lAvgFitr) - Lowest(Low, lAvgFitr);

dif   = MACD(Close, lMacdFast, lMacdSlow);
dem   = XAverage(dif, lMacdSmooth);
xmacd = dif - dem;
LongSignal  = xmacd crosses over LEntry;
LongExitSig = xmacd crosses under LExit;

// ==============================
// Time windows (entries only)
// ==============================
If (t > pSTime) and (t < pETime) then
    TimeWin = 1
else if (t > pSTime2) and (t < pETime2) then
    TimeWin = 2
else
    TimeWin = 0;

ConditionTime = TimeWin > 0;

// ==============================
// Reset entry counts (at the start of each time window)
// ==============================
If TimeWin > 0 and TimeWin <> TimeWin[1] then
Begin
    EntryCount = 0;
    lEntryCount = 0;
End;

// ==============================
// Long Entry (MACD, only when flat)
// ==============================
LongOrder = false;
If lHLRange > lHLScope then
Begin
    lMaxEntries = lBEntryLen + IntPortion(lHLRange / lHLScope);
    If ConditionTime
    and MarketPosition = 0
    and lEntryCount < lMaxEntries
    and AllowLong
    and lFastMA > lSlowMA
    and LongSignal then
    Begin
        Buy("MACD-L") next bar at market;
        lEntryCount = lEntryCount + 1;
        LongOrder = true;
    End;
End;

// ==============================
// Short Entry (when flat, or reversing an open long)
// ==============================
If HLRange > HLScope and LongOrder = false then
Begin
    MaxEntries = pBEntryLen + IntPortion(HLRange / HLScope);
    If ConditionTime
    and MarketPosition >= 0
    and EntryCount < MaxEntries
    and AllowShort
    and FastMA < SlowMA
    and Close < Filter
    and Close < LL then
    Begin
        SellShort("SF2") next bar at Close[3] - BasePoint stop;
        EntryCount = EntryCount + 1;
    End;
End;

// ==============================
// Exit ownership (pExitWin = 1)
// Entry orders fill at the next bar, so the order was sent on the bar before the
// entry bar: the position belongs to this signal if that bar was inside its windows.
// ==============================
If MarketPosition <> 0 and BarsSinceEntry = 0 then
    OwnPos = ConditionTime[1];

ExitOK = (pExitWin = 0) or OwnPos;

// ==============================
// Signal exits
// ==============================
If MarketPosition = 1 and LongExitSig and ExitOK then
    Sell("MACD-LX") next bar at market;

If MarketPosition = -1 and FastMA > SlowMA and ExitOK then
    BuyToCover("SF2Exit") next bar at market;

// ==============================
// Stop loss / profit target (points, from the bar after entry)
// ==============================
If MarketPosition = -1 and ExitOK then
Begin
    If StopLossPt > 0 then
        BuyToCover("SF2SL") next bar at EntryPrice + StopLossPt stop;
End;

If MarketPosition = 1 and ExitOK then
Begin
    If LStopPt > 0 then
        Sell("L-SL") next bar at EntryPrice - LStopPt stop;
End;
