// ==============================
// Strategy: MACD + Direction + Time + Volatility Control  (v2: independent short side)
// Based on 0_NO6_MACD_STOCK (stype=5 threshold-cross logic).
// Long side keeps the original IRF parameters; short side has its own MA filter,
// MACD lengths, entry/exit thresholds and stop/target.
// Short defaults optimized on IRF1 1min 2026/1~10 (commission 600/fill).
// v3 (2026/11/06): session-end guard + next-day price limit + optional marketable-limit entry.
// v4 (2026/11/12): 11/12 S-TP buy limit 735 (entry 835 - 100) rejected 100x (exceeds price limit) -> AT auto-off.
//   Limit estimate also bounded by today's traded range; TP/SL only sent within pNearPct % of Close.
// ==============================

Inputs:
    tradeSignal(0),     // 1=Long only, 0=Both, -1=Short only
    pSTime(0915),
    pETime(2400),
    pLastBar(1345),     // time stamp of the session's last bar (stock futures close 13:45)
    pEntryTk(0),        // 0 = market entry; N>0 = limit at Close +/- N ticks (marketable limit)
    pBEntryLen(1),
    AvgFitr(60),
    HLScope(8),
    // ---- Long ----
    FastAvg(20),
    SlowAvg(120),
    macdFast(20),
    macdSlow(160),
    macdSmooth(9),
    LEntry(0.1),        // long entry: xmacd crosses over
    LExit(-4.8),        // long exit: xmacd crosses under
    LStopPt(17.5),      // points, 0 = off
    LProfitPt(0),       // points, 0 = off
    // ---- Short ----
    sFastAvg(60),
    sSlowAvg(240),
    sMacdFast(15),
    sMacdSlow(240),
    sMacdSmooth(9),
    SEntry(-1.5),       // short entry: short xmacd crosses under
    SExit(6),           // short exit: short xmacd crosses over
    SStopPt(0),         // points, 0 = off
    SProfitPt(100),     // points, 0 = off
    // ---- Price-limit guard (v4, 2026/11/12) ----
    pNearPct(4);        // TP/SL sent only when within pNearPct % of Close (0 = off). A TP 100 pts
                        // (~12%) away is beyond the +/-10% daily band and gets rejected every bar.

Vars:
    dif(0), dem(0), xmacd(0),
    sDif(0), sDem(0), sXmacd(0),
    FastMA(0), SlowMA(0), sFastMA(0), sSlowMA(0),
    LongSignal(false), LongExitSig(false),
    ShortSignal(false), ShortExitSig(false),
    EntryCount(0),
    ConditionTime(false),
    HLRange(0),
    MaxEntries(0),
    AllowLong(false),
    AllowShort(false),
    PrevClose(0),
    UpLimit(99999),
    DnLimit(0),
    IsLastBar(false),
    OrdUp(99999),
    OrdDn(0),
    LExitPend(false),
    SExitPend(false),
    TgtPx(0),
    TkSz(0),
    DayHi(0),
    DayLo(0),
    NearOK(true);

// ==============================
// Direction control
// ==============================
AllowLong  = (tradeSignal = 1) or (tradeSignal = 0);
AllowShort = (tradeSignal = -1) or (tradeSignal = 0);

// ==============================
// Indicator calculation
// ==============================
FastMA  = Average(Close, FastAvg);
SlowMA  = Average(Close, SlowAvg);
sFastMA = Average(Close, sFastAvg);
sSlowMA = Average(Close, sSlowAvg);

dif   = MACD(Close, macdFast, macdSlow);
dem   = XAverage(dif, macdSmooth);
xmacd = dif - dem;

sDif   = MACD(Close, sMacdFast, sMacdSlow);
sDem   = XAverage(sDif, sMacdSmooth);
sXmacd = sDif - sDem;

LongSignal   = xmacd crosses over LEntry;
LongExitSig  = xmacd crosses under LExit;
ShortSignal  = sXmacd crosses under SEntry;
ShortExitSig = sXmacd crosses over SExit;

// ==============================
// Reset entry count + daily price limit (daily)
// Stock futures limit is +/-10% of prior settlement; use prior close with 1% buffer (settlement vs close + tick rounding)
// so TP/SL orders beyond the limit are not sent (broker rejects them).
// ==============================
If Date <> Date[1] then
Begin
    EntryCount = 0;
    PrevClose  = Close[1];
    UpLimit    = PrevClose * 1.09;
    DnLimit    = PrevClose * 0.91;
    DayHi      = High;
    DayLo      = Low;
End
Else
Begin
    If High > DayHi then DayHi = High;
    If Low  < DayLo then DayLo = Low;
End;

// Today's traded range must lie inside today's band (ref +/-10%): ref >= DayHi/1.1 and ref <= DayLo/0.9.
// So the real limit-down is at least DayHi*0.9/1.1 and limit-up at most DayLo*1.1/0.9; tighten the
// close-based estimate with these (catches a stale/wrong PrevClose, e.g. settlement far from close).
If DayHi * 0.9 / 1.1 * 1.005 > DnLimit then DnLimit = DayHi * 0.9 / 1.1 * 1.005;
If DayLo * 1.1 / 0.9 * 0.995 < UpLimit then UpLimit = DayLo * 1.1 / 0.9 * 0.995;

// ==============================
// Session-end guard
// Orders generated on the last bar are live on the NEXT DAY's first bar:
//  - market orders sent after 13:45 are rejected (no fill, strategy/broker position mismatch)
//  - TP/SL prices checked against TODAY's limits can exceed TOMORROW's limits
//    (e.g. short after a -9% day: S-SL < today's UpLimit but > tomorrow's UpLimit).
// So on the last bar: no new entries, signal exits are deferred to the next session,
// and TP/SL prices are checked against tomorrow's estimated limits (today's close +/- 9%).
// ==============================
IsLastBar = (t >= pLastBar);
If IsLastBar then
Begin
    OrdUp = Close * 1.09;
    OrdDn = Close * 0.91;
End
Else
Begin
    OrdUp = UpLimit;
    OrdDn = DnLimit;
End;

// Time filter (entries never on the last bar)
ConditionTime = (t > pSTime) and (t < pETime) and (IsLastBar = false);

// ==============================
// Volatility filter
// ==============================
HLRange = Highest(High, AvgFitr) - Lowest(Low, AvgFitr);

If HLRange > HLScope then
Begin
    MaxEntries = pBEntryLen + IntPortion(HLRange / HLScope);

    // Long Entry
    If ConditionTime
    and MarketPosition = 0
    and EntryCount < MaxEntries
    and AllowLong
    and FastMA > SlowMA
    and Close < UpLimit         // near limit-up: market buy rarely fills (locked), skip
    and LongSignal then
    Begin
        If pEntryTk > 0 then
        Begin
            TkSz  = 5;
            If Close < 1000 then TkSz = 1;
            If Close < 500  then TkSz = 0.5;
            If Close < 100  then TkSz = 0.1;
            If Close < 50   then TkSz = 0.05;
            If Close < 10   then TkSz = 0.01;
            TgtPx = Close + pEntryTk * TkSz;
            If TgtPx > OrdUp then TgtPx = OrdUp;
            TkSz  = 5;                                     // re-tick on the order price (may cross a tier)
            If TgtPx < 1000 then TkSz = 1;
            If TgtPx < 500  then TkSz = 0.5;
            If TgtPx < 100  then TkSz = 0.1;
            If TgtPx < 50   then TkSz = 0.05;
            If TgtPx < 10   then TkSz = 0.01;
            TgtPx = Floor(TgtPx / TkSz + 0.000001) * TkSz;  // buy limit: round down
            Buy("MACD-L") next bar at TgtPx limit;
        End
        Else
            Buy("MACD-L") next bar at market;
        EntryCount = EntryCount + 1;
    End;

    // Short Entry
    If ConditionTime
    and MarketPosition = 0
    and EntryCount < MaxEntries
    and AllowShort
    and sFastMA < sSlowMA
    and Close > DnLimit         // near limit-down: market short rarely fills (locked), skip
    and ShortSignal then
    Begin
        If pEntryTk > 0 then
        Begin
            TkSz  = 5;
            If Close < 1000 then TkSz = 1;
            If Close < 500  then TkSz = 0.5;
            If Close < 100  then TkSz = 0.1;
            If Close < 50   then TkSz = 0.05;
            If Close < 10   then TkSz = 0.01;
            TgtPx = Close - pEntryTk * TkSz;
            If TgtPx < OrdDn then TgtPx = OrdDn;
            TkSz  = 5;                                     // re-tick on the order price (may cross a tier)
            If TgtPx < 1000 then TkSz = 1;
            If TgtPx < 500  then TkSz = 0.5;
            If TgtPx < 100  then TkSz = 0.1;
            If TgtPx < 50   then TkSz = 0.05;
            If TgtPx < 10   then TkSz = 0.01;
            TgtPx = Ceiling(TgtPx / TkSz - 0.000001) * TkSz; // sell limit: round up
            SellShort("MACD-S") next bar at TgtPx limit;
        End
        Else
            SellShort("MACD-S") next bar at market;
        EntryCount = EntryCount + 1;
    End;
End;

// ==============================
// Signal exits (deferred to the next session when the cross happens on the last bar)
// ==============================
If MarketPosition <> 1  then LExitPend = false;
If MarketPosition <> -1 then SExitPend = false;

If MarketPosition = 1 and (LongExitSig or LExitPend) then
Begin
    If IsLastBar then
        LExitPend = true
    Else
        Sell("MACD-LX") next bar at market;
End;

If MarketPosition = -1 and (ShortExitSig or SExitPend) then
Begin
    If IsLastBar then
        SExitPend = true
    Else
        BuyToCover("MACD-SX") next bar at market;
End;

// ==============================
// Stop loss / profit target (points, from the bar after entry)
// Skipped when the price is outside the limit range of the bar the order will live on
// (OrdUp/OrdDn: today's limits, or tomorrow's estimate on the last bar).
// Prices are rounded to the TAIFEX stock futures tick (<10:0.01, <50:0.05, <100:0.1,
// <500:0.5, <1000:1, else 5); EntryPrice + N points can land off-tick (e.g. 498.5+80=578.5)
// and the broker rejects it. Rounding direction keeps the order on the conservative side.
// ==============================
If MarketPosition = 1 then
Begin
    If LStopPt > 0 then
    Begin
        TgtPx = EntryPrice - LStopPt;
        TkSz  = 5;
        If TgtPx < 1000 then TkSz = 1;
        If TgtPx < 500  then TkSz = 0.5;
        If TgtPx < 100  then TkSz = 0.1;
        If TgtPx < 50   then TkSz = 0.05;
        If TgtPx < 10   then TkSz = 0.01;
        TgtPx = Ceiling(TgtPx / TkSz - 0.000001) * TkSz;   // sell stop: round up
        NearOK = (pNearPct <= 0) or (AbsValue(TgtPx - Close) <= Close * pNearPct / 100);
        If TgtPx > OrdDn and TgtPx < OrdUp and NearOK then
            Sell("L-SL") next bar at TgtPx stop;
    End;
    If LProfitPt > 0 then
    Begin
        TgtPx = EntryPrice + LProfitPt;
        TkSz  = 5;
        If TgtPx < 1000 then TkSz = 1;
        If TgtPx < 500  then TkSz = 0.5;
        If TgtPx < 100  then TkSz = 0.1;
        If TgtPx < 50   then TkSz = 0.05;
        If TgtPx < 10   then TkSz = 0.01;
        TgtPx = Ceiling(TgtPx / TkSz - 0.000001) * TkSz;   // sell limit: round up
        NearOK = (pNearPct <= 0) or (AbsValue(TgtPx - Close) <= Close * pNearPct / 100);
        If TgtPx < OrdUp and TgtPx > OrdDn and NearOK then
            Sell("L-TP") next bar at TgtPx limit;
    End;
End;

If MarketPosition = -1 then
Begin
    If SStopPt > 0 then
    Begin
        TgtPx = EntryPrice + SStopPt;
        TkSz  = 5;
        If TgtPx < 1000 then TkSz = 1;
        If TgtPx < 500  then TkSz = 0.5;
        If TgtPx < 100  then TkSz = 0.1;
        If TgtPx < 50   then TkSz = 0.05;
        If TgtPx < 10   then TkSz = 0.01;
        TgtPx = Floor(TgtPx / TkSz + 0.000001) * TkSz;     // buy stop: round down
        NearOK = (pNearPct <= 0) or (AbsValue(TgtPx - Close) <= Close * pNearPct / 100);
        If TgtPx < OrdUp and TgtPx > OrdDn and NearOK then
            BuyToCover("S-SL") next bar at TgtPx stop;
    End;
    If SProfitPt > 0 then
    Begin
        TgtPx = EntryPrice - SProfitPt;
        TkSz  = 5;
        If TgtPx < 1000 then TkSz = 1;
        If TgtPx < 500  then TkSz = 0.5;
        If TgtPx < 100  then TkSz = 0.1;
        If TgtPx < 50   then TkSz = 0.05;
        If TgtPx < 10   then TkSz = 0.01;
        TgtPx = Floor(TgtPx / TkSz + 0.000001) * TkSz;     // buy limit: round down
        NearOK = (pNearPct <= 0) or (AbsValue(TgtPx - Close) <= Close * pNearPct / 100);
        If TgtPx > OrdDn and TgtPx < OrdUp and NearOK then
            BuyToCover("S-TP") next bar at TgtPx limit;
    End;
End;
