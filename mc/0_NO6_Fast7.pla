// ==============================
// Strategy: 0_NO6_Fast7 = 0_NO6_Fast6 + fixes for missed shorts in a downtrend (MXF1 1min, 2026/10/29~10/31)
// 1) Window 1 starts at 0845 (Fast6 0915 blocked the 08:45 gap-down open).
// 2) Short EntryCount counts FILLS, not placed stop orders (Fast6 counted unfilled
//    stop orders, so after a few misses no more shorts were allowed in the window).
// 3) Long protective stop LStopPt defaults to 300 (Fast6 0 = off): 1min xmacd stays
//    above LExit(-60) in a slow grind lower, so the MACD long was held with no exit.
//    Optional LTrendExit closes the long when lFastMA < lSlowMA.
// 4) SEntryMode: 0 = SellShort at Close[3] - BasePoint stop (Fast6),
//                1 = SellShort at Close - SEntryGap stop (easier fill in a slow decline).
// Time windows only gate entries; exits are always active (same as Fast6).
// Set pSTime2 = pETime2 to disable the second window.
// ==============================

Inputs:
    tradeSignal(0),      // 1=Long only, 0=Both, -1=Short only
    pSTime(0845),        // window 1 (entry allowed when pSTime < t < pETime)
    pETime(2400),
    pSTime2(0000),       // window 2
    pETime2(0450),
    // ---- Short ----
    pBEntryLen(3),
    FastAvg(90),
    SlowAvg(150),
    AvgFitr(90),
    HLScope(350),
    SEntryMode(0),       // 0 = Close[3] - BasePoint stop, 1 = Close - SEntryGap stop
    BasePoint(150),
    SEntryGap(30),
    StopLossPt(300),     // points, 0 = off
    TakeProfitPt(1200),  // points, 0 = off
    // ---- Long (MACD) ----
    lBEntryLen(1),
    lFastAvg(60),
    lSlowAvg(200),
    lAvgFitr(60),
    lHLScope(50),
    lMacdFast(25),
    lMacdSlow(80),
    lMacdSmooth(9),
    LEntry(-5),          // long entry: xmacd crosses over
    LExit(-60),          // long exit: xmacd crosses under
    LTrendExit(0),       // 1 = also exit long when lFastMA < lSlowMA
    LStopPt(300),        // points, 0 = off
    LProfitPt(2500);     // points, 0 = off

Vars:
    FastMA(0), SlowMA(0), Filter(0), HH(0), LL(0),
    HLRange(0), MaxEntries(0), EntryCount(0),
    lFastMA(0), lSlowMA(0), lHLRange(0), lMaxEntries(0), lEntryCount(0),
    dif(0), dem(0), xmacd(0),
    LongSignal(false), LongExitSig(false), LongOrder(false),
    ShortStopPx(0),
    ConditionTime(false),
    TimeWin(0),          // 0 = outside windows, 1 = window 1, 2 = window 2
    AllowLong(false),
    AllowShort(false);

// ==============================
// Direction control
// ==============================
AllowLong  = (tradeSignal = 1) or (tradeSignal = 0);
AllowShort = (tradeSignal = -1) or (tradeSignal = 0);

// ==============================
// Indicator calculation
// ==============================
FastMA = Average(Close, FastAvg);
SlowMA = Average(Close, SlowAvg);
Filter = Average(Close, AvgFitr);
HH = Highest(High, AvgFitr)[1];
LL = Lowest(Low, AvgFitr)[1];
HLRange = Highest(High, AvgFitr) - Lowest(Low, AvgFitr);

lFastMA = Average(Close, lFastAvg);
lSlowMA = Average(Close, lSlowAvg);
lHLRange = Highest(High, lAvgFitr) - Lowest(Low, lAvgFitr);

dif   = MACD(Close, lMacdFast, lMacdSlow);
dem   = XAverage(dif, lMacdSmooth);
xmacd = dif - dem;
LongSignal  = xmacd crosses over LEntry;
LongExitSig = xmacd crosses under LExit;

// ==============================
// Time windows (entries only)
// ==============================
If (t > pSTime) and (t < pETime) then
    TimeWin = 1
else if (t > pSTime2) and (t < pETime2) then
    TimeWin = 2
else
    TimeWin = 0;

ConditionTime = TimeWin > 0;

// ==============================
// Reset entry counts (at the start of each time window)
// ==============================
If TimeWin > 0 and TimeWin <> TimeWin[1] then
Begin
    EntryCount = 0;
    lEntryCount = 0;
End;

// ==============================
// Count filled shorts (a short filled on this bar)
// ==============================
If MarketPosition = -1 and BarsSinceEntry = 0 then
    EntryCount = EntryCount + 1;

// ==============================
// Long Entry (MACD, only when flat)
// ==============================
LongOrder = false;
If lHLRange > lHLScope then
Begin
    lMaxEntries = lBEntryLen + IntPortion(lHLRange / lHLScope);
    If ConditionTime
    and MarketPosition = 0
    and lEntryCount < lMaxEntries
    and AllowLong
    and lFastMA > lSlowMA
    and LongSignal then
    Begin
        Buy("MACD-L") next bar at market;
        lEntryCount = lEntryCount + 1;
        LongOrder = true;
    End;
End;

// ==============================
// Short Entry (when flat, or reversing an open long)
// ==============================
If HLRange > HLScope and LongOrder = false then
Begin
    MaxEntries = pBEntryLen + IntPortion(HLRange / HLScope);
    If ConditionTime
    and MarketPosition >= 0
    and EntryCount < MaxEntries
    and AllowShort
    and FastMA < SlowMA
    and Close < Filter
    and Close < LL then
    Begin
        If SEntryMode = 1 then
            ShortStopPx = Close - SEntryGap
        else
            ShortStopPx = Close[3] - BasePoint;
        SellShort("SF2") next bar at ShortStopPx stop;
    End;
End;

// ==============================
// Signal exits
// ==============================
If MarketPosition = 1 and LongExitSig then
    Sell("MACD-LX") next bar at market;

If MarketPosition = 1 and LTrendExit = 1 and lFastMA < lSlowMA then
    Sell("L-TrendX") next bar at market;

If MarketPosition = -1 and FastMA > SlowMA then
    BuyToCover("SF2Exit") next bar at market;

// ==============================
// Stop loss / profit target (points, from the bar after entry)
// ==============================
If MarketPosition = -1 then
Begin
    If StopLossPt > 0 then
        BuyToCover("SF2SL") next bar at EntryPrice + StopLossPt stop;
    If TakeProfitPt > 0 then
        BuyToCover("SF2TP") next bar at EntryPrice - TakeProfitPt limit;
End;

If MarketPosition = 1 then
Begin
    If LStopPt > 0 then
        Sell("L-SL") next bar at EntryPrice - LStopPt stop;
    If LProfitPt > 0 then
        Sell("L-TP") next bar at EntryPrice + LProfitPt limit;
End;
